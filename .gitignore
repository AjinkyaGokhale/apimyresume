# Dependencies
node_modules/

# Runtime data (DB, API keys, PDFs) — never commit
data/

# Logs
*.log

# OS
.DS_Store

# Secrets
.env
.env.local

# Build output
dist/
packages/dashboard/build/
packages/dashboard/.svelte-kit/

# Vendored upstream cover-letter package: keep it on disk for reference but track
# only the adapted default template (and its MIT license) used by the registry.
# Everything else here — including its embedded .git — stays out of this repo.
/templates/typst-coverletter/*
!/templates/typst-coverletter/cover-letter.typ
!/templates/typst-coverletter/config.json
!/templates/typst-coverletter/LICENSE

